{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/core/**/*",
    "src/shared/**/*"
  ],
  "exclude": ["src/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@core/*": ["./src/core/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
